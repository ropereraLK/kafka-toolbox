# Kafka Docker version (official Apache image)
KAFKA_VERSION=4.1.1

# Zookeeper Docker version (official image)
ZOOKEEPER_VERSION=3.9.0

# Optional: Docker network or other configs
DOCKER_NETWORK=kafka-network

# Kafka Brokers
BROKER1_ID=1
BROKER2_ID=2
BROKER3_ID=3

# Ports for brokers
BROKER1_PORT=9092
BROKER2_PORT=9093
BROKER3_PORT=9094

# Replication factor (≤ number of brokers)
REPLICATION_FACTOR=3
PARTITIONS=3
